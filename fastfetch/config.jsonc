{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii_wolf.txt",
    "height": 18,
    "padding": {
      "top": 5
    },
    "color": {
      "1": "red"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[31mSYSTEM"
    },
    {
      "type": "os",
      "key": " ├   OS         ",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": " ├   Kernel     ",
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "format": "{driver}",
      "key": " ├ 󰢮  GPU Driver ",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": " ├ 󰏖  Packages   ",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": " ├   Shell      ",
      "keyColor": "red"
    },
    {
      "type": "localip",
      "key": " ├ 󰩟  Network    ",
      "keyColor": "red",
      "format": "{ipv4} ({ifname})"
    },
    {
      "type": "uptime",
      "key": " ├   Uptime     ",
      "keyColor": "red"
    },
    {
      "type": "command",
      "key": " └ 󱦟  OS Age     ",
      "keyColor": "red",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[31mDESKTOP"
    },
    {
      "type": "de",
      "key": " ├   DE         ",
      "keyColor": "red"
    },
    {
      "type": "wm",
      "key": " ├   WM         ",
      "keyColor": "red"
    },
    {
      "type": "wmtheme",
      "key": " ├ 󰉼  Theme      ",
      "keyColor": "red"
    },
    {
      "type": "theme",
      "key": " ├ 󰉼  Theme      ",
      "keyColor": "red"
    },
    {
      "type": "icons",
      "key": " ├ 󰀻  Icons      ",
      "keyColor": "red"
    },
    {
      "type": "font",
      "key": " ├   Font       ",
      "keyColor": "red"
    },
    {
      "type": "cursor",
      "key": " ├   Cursor     ",
      "keyColor": "red"
    },
    {
      "type": "terminal",
      "key": " ├   Terminal   ",
      "keyColor": "red"
    },
    {
      "type": "terminalfont",
      "key": " └   Term Font  ",
      "keyColor": "red"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[31mHARDWARE"
    },
    {
      "type": "cpu",
      "format": "{name} ({cores-logical}) @ {freq-max}",
      "key": " ├   CPU        ",
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": " ├ 󰢮  GPU        ",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": " ├   Memory     ",
      "keyColor": "red"
    },
    {
      "type": "swap",
      "key": " ├ 󰓡  Swap       ",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem} ({mountpoint})",
      "key": " ├ 󰋊  Disk       ",
      "keyColor": "red"
    },
    {
      "type": "display",
      "format": "{width}x{height} in {inch}\", {refresh-rate} Hz [{type}]",
      "key": " ├   Display    ",
      "keyColor": "red"
    },
    {
      "type": "command",
      "text": "echo \"$(cat /sys/class/dmi/id/board_name) (BIOS Version $(cat /sys/class/dmi/id/bios_version))\"",
      "key": " └   Board      ",
      "keyColor": "red"
    }
  ],
  "display": {
    "color": {
      "keys": "#eba0ac",
      "title": "#9399b2"
    },
    "percent": {
      "color": {
        "red": "#f38ba8",
        "yellow": "#e996a3"
      }
    }
  }
}
